RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteBase /

# Pretty URLs for PHP pages
RewriteRule ^uslugi/?$ uslugi.php [L]
RewriteRule ^proekti/?$ proekti.php [L]
RewriteRule ^proekti/([a-zA-Z0-9_-]+)/?$ proekt.php?slug=$1 [L]
RewriteRule ^kontakti/?$ kontakti.php [L]
RewriteRule ^zapazi/?$ zapazi.php [L]
RewriteRule ^za-nas/?$ za-nas.php [L]

# Admin
RewriteRule ^admin/?$ admin/index.php [L]

# Protect sensitive files
RewriteRule ^(inc|data|config\.php) - [F]
