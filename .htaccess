RewriteEngine On


# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

# Cache-Control for static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteBase /

# Pretty URLs for PHP pages
RewriteRule ^uslugi/?$ uslugi.php [L]
RewriteRule ^proekti/?$ proekti.php [L]
RewriteRule ^proekti/([a-zA-Z0-9_-]+)/?$ proekt.php?slug=$1 [L]
RewriteRule ^kontakti/?$ kontakti.php [L]
RewriteRule ^zapazi/?$ zapazi.php [L]
RewriteRule ^za-nas/?$ za-nas.php [L]
RewriteRule ^otzivi/?$ otzivi.php [L]
RewriteRule ^review/?$ otzivi.php [L]

# Admin
RewriteRule ^admin/?$ admin/index.php [L]

# Protect sensitive files
RewriteRule ^(inc|data|config\.php) - [F]
